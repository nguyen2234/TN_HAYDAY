# Base URL for a real backend. When set, all /api/* requests are sent here
# instead of being intercepted by the in-browser MSW mock layer.
# Leave empty to use the mock API (default for local development).
VITE_API_BASE_URL=

# Sentry DSN for client-side error reporting. When set, the app lazily
# initializes @sentry/browser and reports exceptions/events. Leave empty
# to keep monitoring inert (it falls back to console logging).
VITE_SENTRY_DSN=

# Environment label attached to Sentry events (e.g. "production", "staging").
# Defaults to the Vite mode when unset.
VITE_APP_ENV=
